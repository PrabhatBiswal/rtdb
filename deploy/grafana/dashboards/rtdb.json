        "graphMode": "area",
        "textMode": "auto"
      }
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "Listen setups/s",
      "description": "\u00a73 decides catch-up vs fresh snapshot. A snapshot spike with no deploy is the mass-reconnect storm \u00a78 warns about; `toobig` means a subtree passed SNAPSHOT_MAX and those subscriptions are dead until the app splits the path.",
      "datasource": {
        "type": "prometheus",
        "uid": "rtdb-prom"
      },
      "gridPos": {
        "h": 7,
        "w": 8,
        "x": 0,
        "y": 33
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "rtdb-prom"
          },
          "expr": "sum by (result) (rate(rtdb_listens_total[1m]))",
          "legendFormat": "{{result}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "cps",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 15,
            "showPoints": "never",
            "stacking": {
              "mode": "none",
              "group": "A"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "Resync frames/s",
      "description": "Slow consumers being repaired (\u00a73). Steady non-zero means clients cannot drain what this shard fans out to them.",
      "datasource": {
        "type": "prometheus",
        "uid": "rtdb-prom"
      },
      "gridPos": {
        "h": 7,
        "w": 8,
        "x": 8,
        "y": 33
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
