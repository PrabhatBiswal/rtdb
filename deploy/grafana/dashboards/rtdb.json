{
  "uid": "rtdb-gateway",
  "title": "RTDB \u2014 gateways",
  "tags": [
    "rtdb"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 2,
  "editable": true,
  "refresh": "10s",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Connections",
      "description": "\u00a78 sizes EVERY gateway to carry 100% of these. Two flat lines that sum to the fleet total is the healthy shape; one line at zero with the other doubled is a survivor carrying everyone \u2014 fine, and exactly what the sizing rule buys.",
      "datasource": {
        "type": "prometheus",
        "uid": "rtdb-prom"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "rtdb-prom"
          },
          "expr": "rtdb_connections",
          "legendFormat": "{{instance}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 15,
            "showPoints": "never",
            "stacking": {
              "mode": "none",
              "group": "A"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "last",
            "max"
          ],
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Writes/s by op",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "rtdb-prom"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 0
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "rtdb-prom"
          },
          "expr": "sum by (op) (rate(rtdb_writes_total[1m]))",
          "legendFormat": "{{op}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "wps",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 15,
            "showPoints": "never",
            "stacking": {
              "mode": "none",
              "group": "A"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Write outcomes/s",
      "description": "casFail is a NORMAL outcome (\u00a74), not an error. `err` and `rate` are the two lines that mean a client is being refused.",
      "datasource": {
        "type": "prometheus",
        "uid": "rtdb-prom"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 0
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "rtdb-prom"
          },
          "expr": "sum by (result) (rate(rtdb_acks_total[1m]))",
          "legendFormat": "{{result}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "wps",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 15,
            "showPoints": "never",
            "stacking": {
              "mode": "none",
              "group": "A"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Ack latency",
      "description": "Client write frame -> its ack leaving the pipeline. Includes the \u00a74 group-commit window by design. Buckets reach 300s. Before WP7 the top bucket was 10s, so the load test's 89.6s p50 rendered as a flat 10.000 \u2014 a saturated histogram and a genuine ten-second ack drew the same line.",
      "datasource": {
        "type": "prometheus",
        "uid": "rtdb-prom"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "rtdb-prom"
          },
          "expr": "histogram_quantile(0.5, sum by (le) (rate(rtdb_ack_seconds_bucket[1m])))",
          "legendFormat": "p50",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "rtdb-prom"
          },
          "expr": "histogram_quantile(0.99, sum by (le) (rate(rtdb_ack_seconds_bucket[1m])))",
          "legendFormat": "p99",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 15,
            "showPoints": "never",
            "stacking": {
              "mode": "none",
              "group": "A"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Deltas out/s",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "rtdb-prom"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "rtdb-prom"
          },
          "expr": "sum(rate(rtdb_deltas_out_total[1m]))",
          "legendFormat": "fleet",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "rtdb-prom"
          },
          "expr": "rate(rtdb_deltas_out_total[1m])",
          "legendFormat": "{{instance}}",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "cps",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 15,
            "showPoints": "never",
            "stacking": {
              "mode": "none",
              "group": "A"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Sink queue wait (gateway-side fanout)",
      "description": "Only the time a frame waited in the \u00a73 micro-batch window \u2014 it is bounded by DELTA_BATCH_MS by construction and does NOT include the commit -> bus -> gateway hop. Use `Consumer lag` for that half.",
      "datasource": {
        "type": "prometheus",
        "uid": "rtdb-prom"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "rtdb-prom"
          },
          "expr": "histogram_quantile(0.5, sum by (le) (rate(rtdb_fanout_seconds_bucket[1m])))",
          "legendFormat": "p50",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "rtdb-prom"
          },
          "expr": "histogram_quantile(0.99, sum by (le) (rate(rtdb_fanout_seconds_bucket[1m])))",
          "legendFormat": "p99",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 15,
            "showPoints": "never",
            "stacking": {
              "mode": "none",
              "group": "A"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Consumer lag (revs behind the oplog head, max per step)",
      "description": "THE ElastiCache signal. Sits at 0-ish under traffic; a gateway climbing while the other stays flat is that gateway's bus connection, a fleet-wide climb is the bus itself. Also climbs when a leader is elected but cannot publish \u2014 check the panel to the right. Plotted as max_over_time over each step, not the raw sample: at a wide time range Grafana asks Prometheus for one sample per step, and the 2026-08-29 load test peaked at 63,173 revs while the instantaneous series read 0 \u2014 the >5000 alert was never going to fire. The legend's Max column is therefore the true peak of the window, not a sampled one.",
      "datasource": {
        "type": "prometheus",
        "uid": "rtdb-prom"
      },
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 0,
        "y": 16
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "rtdb-prom"
          },
          "expr": "max_over_time(rtdb_consumer_lag_revs[$__interval])",
          "legendFormat": "{{instance}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 15,
            "showPoints": "never",
            "stacking": {
              "mode": "none",
              "group": "A"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "last",
            "max"
          ],
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Leader / publishing",
      "description": "\u00a78: exactly ONE gateway may report leader=1. Two is a split brain and the lock is broken. leader=1 with publishing=0 is a promotion that could not read the stream tail \u2014 it retries, and the consumer lag panel is what shows the cost.",
      "datasource": {
        "type": "prometheus",
        "uid": "rtdb-prom"
      },
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 12,
        "y": 16
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "rtdb-prom"
          },
          "expr": "rtdb_leader",
          "legendFormat": "leader {{instance}}",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "rtdb-prom"
          },
          "expr": "rtdb_publishing",
          "legendFormat": "publishing {{instance}}",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "max": 1,
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "never",
            "stacking": {
              "mode": "none",
              "group": "A"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Egress by top-level path prefix",
      "description": "The roadmap's per-path bandwidth, and the only app-dependent term in the cost model (~$0.109/GB out of ap-south-1). Labelled by the ~14 dbName namespaces only \u2014 a label per full path would be unbounded cardinality. `_other` means the 64-prefix cap was hit.",
      "datasource": {
        "type": "prometheus",
        "uid": "rtdb-prom"
      },
      "gridPos": {
        "h": 8,
        "w": 16,
        "x": 0,
        "y": 25
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "rtdb-prom"
          },
          "expr": "sum by (prefix) (rate(rtdb_bytes_out_total[1m]))",
          "legendFormat": "{{prefix}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "Bps",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 60,
            "showPoints": "never",
            "stacking": {
              "mode": "normal",
              "group": "A"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "last",
            "max"
          ],
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 10,
      "type": "stat",
      "title": "Egress, last 24h",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "rtdb-prom"
