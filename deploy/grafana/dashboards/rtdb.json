    {
      "id": 14,
      "type": "timeseries",
      "title": "Event-loop lag p99 (max per step)",
      "description": "Tells 'the gateway is slow' apart from 'the database is slow'. Max over each step for the same reason as the consumer-lag panel: a stall between two samples is exactly the thing worth seeing.",
      "datasource": {
        "type": "prometheus",
        "uid": "rtdb-prom"
