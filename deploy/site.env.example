# Copy to `site.env` and fill in. `site.env` is gitignored: it names YOUR deployment, and a public
# repo must not carry one operator's domain as a default (same rule as `deploy/*.tfvars`, and the
# same rule commit 862acb1 applied to image tags).
#
#   cp deploy/site.env.example deploy/site.env && $EDITOR deploy/site.env
#
# Unset is not fatal. Scripts that need a name say which one and skip that step; they never guess.
RTDB_ENDPOINT=wss://rtdb.example.com
CONSOLE_URL=https://console.example.com

# The boxes fleet-wake.sh / fleet-sleep.sh act on. No defaults in the code: a committed instance id
# targets someone else's account, and `aws ec2 start-instances` on an id that is not yours does not
# fail in a way anyone reads as "wrong id".
GW1=i-0000000000000000
GW2=i-0000000000000000
OPS=i-0000000000000000
RDS=your-rds-identifier
